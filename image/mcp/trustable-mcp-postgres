#!/bin/sh
set -eu

database_uri="${DATABASE_URI:-${POSTGRES_URL:-}}"
if [ -z "$database_uri" ]; then
    echo "DATABASE_URI or POSTGRES_URL is required for postgres MCP" >&2
    exit 1
fi

access_mode="${POSTGRES_MCP_ACCESS_MODE:-unrestricted}"
exec postgres-mcp "--access-mode=${access_mode}" "$database_uri"
