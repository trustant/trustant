#!/bin/sh
set -eu

case "${REDIS_PORT:-}" in
    ""|*[!0-9]*)
        if [ -n "${REDIS_SERVICE_PORT:-}" ]; then
            export REDIS_PORT="$REDIS_SERVICE_PORT"
        elif [ -n "${REDIS_URL:-}" ]; then
            unset REDIS_PORT
        fi
        ;;
esac

if [ -n "${REDIS_URL:-}" ]; then
    exec redis-mcp-server --url "$REDIS_URL"
fi

if [ -z "${REDIS_HOST:-}" ]; then
    echo "REDIS_URL or REDIS_HOST is required for redis MCP" >&2
    exit 1
fi

set -- redis-mcp-server --host "$REDIS_HOST"

if [ -n "${REDIS_PORT:-}" ]; then
    set -- "$@" --port "$REDIS_PORT"
fi
if [ -n "${REDIS_DB:-}" ]; then
    set -- "$@" --db "$REDIS_DB"
fi
if [ -n "${REDIS_USERNAME:-}" ]; then
    set -- "$@" --username "$REDIS_USERNAME"
fi
if [ -n "${REDIS_PWD:-}" ]; then
    set -- "$@" --password "$REDIS_PWD"
fi
if [ "${REDIS_SSL:-}" = "true" ] || [ "${REDIS_SSL:-}" = "1" ]; then
    set -- "$@" --ssl
fi
if [ -n "${REDIS_SSL_CA_PATH:-}" ]; then
    set -- "$@" --ssl-ca-path "$REDIS_SSL_CA_PATH"
fi
if [ -n "${REDIS_SSL_KEYFILE:-}" ]; then
    set -- "$@" --ssl-keyfile "$REDIS_SSL_KEYFILE"
fi
if [ -n "${REDIS_SSL_CERTFILE:-}" ]; then
    set -- "$@" --ssl-certfile "$REDIS_SSL_CERTFILE"
fi
if [ -n "${REDIS_SSL_CERT_REQS:-}" ]; then
    set -- "$@" --ssl-cert-reqs "$REDIS_SSL_CERT_REQS"
fi
if [ -n "${REDIS_SSL_CA_CERTS:-}" ]; then
    set -- "$@" --ssl-ca-certs "$REDIS_SSL_CA_CERTS"
fi
if [ "${REDIS_CLUSTER_MODE:-}" = "true" ] || [ "${REDIS_CLUSTER_MODE:-}" = "1" ]; then
    set -- "$@" --cluster-mode
fi

exec "$@"
