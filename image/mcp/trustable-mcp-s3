#!/bin/sh
set -eu

if [ -z "${AWS_ACCESS_KEY_ID:-}" ] && [ -n "${S3_ACCESS_KEY:-}" ]; then
    export AWS_ACCESS_KEY_ID="$S3_ACCESS_KEY"
fi
if [ -z "${AWS_SECRET_ACCESS_KEY:-}" ] && [ -n "${S3_SECRET_KEY:-}" ]; then
    export AWS_SECRET_ACCESS_KEY="$S3_SECRET_KEY"
fi
if [ -z "${AWS_REGION:-}" ]; then
    export AWS_REGION="${S3_REGION:-us-east-1}"
fi

if [ -z "${S3_ENDPOINT:-}" ] && [ -n "${S3_HOST:-}" ]; then
    s3_proto="${S3_PROTO:-http}"
    if [ -n "${S3_PORT:-}" ]; then
        export S3_ENDPOINT="${s3_proto}://${S3_HOST}:${S3_PORT}"
    else
        export S3_ENDPOINT="${s3_proto}://${S3_HOST}"
    fi
fi

if [ -n "${S3_ENDPOINT:-}" ] && [ -z "${S3_USE_PATH_STYLE:-}" ]; then
    export S3_USE_PATH_STYLE=true
fi

export MCP_S3_EXT_READONLY="${MCP_S3_EXT_READONLY:-false}"

exec mcp-s3
