{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["opencode.md"],
  "enabled_providers": [
    "ollama"
  ],
  "model": "ollama/qwen3-trustable:30b",
  "small_model": "ollama/llama3.2:3b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "trustable-qwen3-coder:30b": {
          "name": "trustable-qwen3-coder:30b",
          "reasoning": false
        },
        "trustable-llama3.2:3b": {
          "name":  "trustable-llama3.2:3b",
          "reasoning": false
        },
        "trustable-gpt-oss:20b": {
          "name":  "trustable-gpt-oss:20b",
          "reasoning": true
        }
      }
    }
  }
}