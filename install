echo @'
' > /dev/null
#vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv
# Bash Start -----------------------------------------------------------
#
# install - Trustant installer, one file for bash and PowerShell.
#   curl -fsSL get.trustant.ai | bash      (macOS, Linux)
#   irm get.trustant.ai | iex              (Windows)
# Asks for a target folder (default: the current directory), creates it if
# needed, clones https://github.com/trustant/trustant with its submodules into
# <target>/trustant and runs start.sh / start.ps1 there. A <target>/dist (the
# .deb and ollama downloads, preloaded) is copied into trustant/dist, so start.sh
# downloads nothing again. TRUSTANT_DIR names the checkout
# directly and skips the question (non-interactive installs).
# TRUSTANT_REF selects a branch or tag (default: the repo default branch).
# See spec/install.md. Keep this file pure ASCII (Windows PowerShell 5.1).

URL="https://github.com/trustant/trustant"
# Under `curl | bash` stdin is the script itself: prompts (sudo, brew,
# start.sh) must read the terminal instead.
TTY=/dev/stdin
if [ ! -t 0 ] && [ -r /dev/tty ]
then TTY=/dev/tty
fi
if [ -n "${TRUSTANT_DIR:-}" ]
then DEST="$TRUSTANT_DIR"
else
   TARGET="$(pwd)"
   # Ask only when there is a terminal to answer: reading /dev/stdin under a
   # bare pipe would swallow the rest of this script.
   if [ -t 0 ] || [ "$TTY" = /dev/tty ]
   then
      printf 'Install Trustant in [%s]: ' "$TARGET"
      { read -r ANSWER <"$TTY"; } 2>/dev/null || { ANSWER=""; echo; }
      case "$ANSWER" in
      ("~") ANSWER="$HOME" ;;
      ("~/"*) ANSWER="$HOME/${ANSWER#"~/"}" ;;
      esac
      [ -n "$ANSWER" ] && TARGET="$ANSWER"
   fi
   if ! mkdir -p "$TARGET" || ! cd "$TARGET"
   then
      echo "cannot use $TARGET - exiting"
      exit 1
   fi
   DEST="$(pwd)/trustant"
fi

case "$(uname -s)" in
(Darwin)
   if ! command -v brew >/dev/null
   then
      echo "brew is required to install Trustant"
      echo "please install it from https://brew.sh"
      exit 1
   fi
   command -v limactl >/dev/null || brew install lima <"$TTY" || exit 1
   command -v git >/dev/null || brew install git <"$TTY" || exit 1
;;
(Linux)
   for cmd in apt-get sudo
   do
      if ! command -v "$cmd" >/dev/null
      then
         echo "$cmd is required to install Trustant"
         exit 1
      fi
   done
   if [ "$(id -u)" != "0" ] && ! sudo -v <"$TTY"
   then
      echo "you need sudo powers to install Trustant"
      exit 1
   fi
   if ! command -v git >/dev/null
   then
      { sudo apt-get update && sudo apt-get install -y git; } <"$TTY" || exit 1
   fi
;;
(MINGW*|MSYS*|CYGWIN*)
   echo "Please use PowerShell to install Trustant on Windows:"
   echo "   irm get.trustant.ai | iex"
   exit 1
;;
(*)
   echo "unsupported system $(uname -s) - exiting"
   exit 1
;;
esac

# Requirements, checked before anything is cloned: report every problem, then
# stop. Memory allows 7.5 GiB because an "8 GB" machine reports a bit less.
FAIL=0
fail() { echo "ERROR: $*"; FAIL=1; }
if [ "$(uname -s)" = Darwin ]
then
   MEM_KB=$(( $(sysctl -n hw.memsize) / 1024 ))
   CPUS=$(sysctl -n hw.ncpu)
   MINIOPS=$(dscacheutil -q host -a name miniops.me | awk '/^ip_address:/{print $2; exit}')
else
   MEM_KB=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
   CPUS=$(nproc)
   MINIOPS=$(getent ahostsv4 miniops.me | awk '{print $1; exit}')
fi
DIR="$(dirname "$DEST")"
while [ ! -d "$DIR" ]
do DIR="$(dirname "$DIR")"
done
DISK_KB=$(df -Pk "$DIR" | awk 'NR==2{print $4}')
[ "${MEM_KB:-0}" -ge 7864320 ] \
   || fail "at least 8 GB of memory is required (found $(( ${MEM_KB:-0} / 1048576 )) GB)"
[ "${CPUS:-0}" -ge 4 ] \
   || fail "at least 4 CPUs are required (found ${CPUS:-0})"
[ "${DISK_KB:-0}" -ge 52428800 ] \
   || fail "at least 50 GB of free disk space is required in $DIR (found $(( ${DISK_KB:-0} / 1048576 )) GB)"
if [ "$MINIOPS" != "127.0.0.1" ]
then
   fail "miniops.me resolves to ${MINIOPS:-nothing}, not 127.0.0.1: your router is blocking miniops.me.
    Please either change your DNS to 8.8.8.8 and 1.1.1.1, or add an exception for miniops.me to the router."
fi
# Linux runs k3s on this host, which needs :80 and :443 - unless it is
# Trustant's own k3s already holding them.
if [ "$(uname -s)" = Linux ] && ! systemctl is-active --quiet k3s 2>/dev/null
then
   if command -v ss >/dev/null
   then
      BUSY=$(sudo ss -ltnpH '( sport = :80 or sport = :443 )' </dev/null | awk '{print "      " $4 "  " $NF}' | sort -u)
      if [ -n "$BUSY" ]
      then
         fail "ports 80 and 443 must be free, but they are in use:
$BUSY
    Stop the service using them, e.g.: sudo systemctl stop nginx"
      fi
   else
      echo "WARNING: ss not found - cannot check that ports 80 and 443 are free"
   fi
fi
if [ "$FAIL" = 1 ]
then
   echo "This machine does not meet the Trustant requirements - exiting"
   exit 1
fi

if [ -e "$DEST" ]
then
   echo "$DEST already exists - remove it, or cd there and run ./start.sh"
   exit 1
fi

echo "Cloning Trustant into $DEST"
if ! git clone --recurse-submodules ${TRUSTANT_REF:+--branch "$TRUSTANT_REF"} "$URL" "$DEST"
then
   echo "git clone failed - exiting"
   rm -rf "$DEST"
   exit 1
fi
# A dist/ next to the checkout (the .deb and ollama downloads, preloaded) is
# copied into trustant/dist, start.sh's cache, so nothing is downloaded again.
SRC="$(dirname "$DEST")/dist"
if [ -d "$SRC" ]
then
   echo "Copying $SRC into $DEST/dist"
   mkdir -p "$DEST/dist" && cp -R "$SRC/." "$DEST/dist/" \
      || echo "copying $SRC failed - start.sh will download what is missing"
fi

cd "$DEST" || exit 1
# Lima mounts this folder at the same path in the VM, so host paths work there.
HERE="$(pwd)"
cat > .env <<ENV
WORKSPACE_DIR=$HERE/workspace
WORKBENCH_DIR=$HERE/workbench
OLLAMA_ENDPOINT=http://localhost:11434
AIP_REGISTER_URL=https://api.nuvolaris.io/_register
AIP_BASE_URL=https://api.nuvolaris.io/api/v2/
GIT_USER=TrustantUser
GIT_EMAIL=noreply@example.com
ENV
mkdir -p workspace workbench || exit 1
exec ./start.sh <"$TTY"

exit 0

# Above this line is Bash Script -------------------------------------------
# ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
echo > /dev/null <<"out-null" ###
'@ | out-null
#vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv
# Below this line is Powershell Script -------------------------------------
#
# Never `exit` here: under `irm | iex` it would close the user's window.
# Everything runs in one scriptblock so `return` stops it in both modes.

& {
    if ([System.Environment]::OSVersion.Platform -ne 'Win32NT') {
        Write-Host "This installer is for Windows PowerShell - on macOS/Linux run:"
        Write-Host "   curl -fsSL get.trustant.ai | bash"
        return
    }

    $Url = 'https://github.com/trustant/trustant'
    # Resolved against the PowerShell location, not the process directory that
    # [IO.Path]::GetFullPath would use: they differ, e.g. after a cd to D:\.
    $Resolve = { param($p) $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($p) }
    if ($env:TRUSTANT_DIR) {
        $Dest = & $Resolve $env:TRUSTANT_DIR
        $Target = Split-Path -Parent $Dest
    } else {
        $Target = (Get-Location).ProviderPath
        $Answer = "$(Read-Host "Install Trustant in [$Target]")".Trim().Trim('"')
        # A bare drive (D:) means its root, not that drive's current folder.
        if ($Answer -match '^[A-Za-z]:$') { $Answer += '\' }
        if ($Answer) { $Target = & $Resolve $Answer }
        $Dest = Join-Path $Target 'trustant'
    }
    # The folder is used from WSL over /mnt/<drive>: a space breaks .env and the
    # scripts, and only a drive-letter path (any drive) maps to /mnt/<drive>.
    if ($Dest -match ' ') {
        Write-Host "The install path '$Dest' contains spaces - choose a folder without spaces"
        return
    }
    if ($Dest -notmatch '^[A-Za-z]:\\') {
        Write-Host "The install path '$Dest' is not on a drive letter (e.g. C:\ or D:\) - WSL cannot mount it"
        return
    }
    if (-not (Test-Path ($Dest.Substring(0, 3)))) {
        Write-Host "Drive $($Dest.Substring(0, 2)) is not available on this machine"
        return
    }

    # Requirements, checked before anything is cloned: report every problem,
    # then stop. Memory allows 7.5 GiB because an "8 GB" machine reports a bit less.
    $Failed = $false
    $GB = 1024 * 1024 * 1024
    $Mem = (Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory
    if ($Mem -lt 7.5 * $GB) {
        Write-Host "ERROR: at least 8 GB of memory is required (found $([math]::Floor($Mem / $GB)) GB)"; $Failed = $true
    }
    $Cpus = [Environment]::ProcessorCount
    if ($Cpus -lt 4) {
        Write-Host "ERROR: at least 4 CPUs are required (found $Cpus)"; $Failed = $true
    }
    $Free = ([System.IO.DriveInfo]::new($Dest.Substring(0, 1))).AvailableFreeSpace
    if ($Free -lt 50 * $GB) {
        Write-Host "ERROR: at least 50 GB of free disk space is required on $($Dest.Substring(0, 2)) (found $([math]::Floor($Free / $GB)) GB)"; $Failed = $true
    }
    $Miniops = try {
        [System.Net.Dns]::GetHostAddresses('miniops.me') |
            Where-Object { $_.AddressFamily -eq 'InterNetwork' } | Select-Object -First 1
    } catch { $null }
    if ("$Miniops" -ne '127.0.0.1') {
        $Got = if ($Miniops) { "$Miniops" } else { 'nothing' }
        Write-Host "ERROR: miniops.me resolves to $Got, not 127.0.0.1: your router is blocking miniops.me."
        Write-Host "    Please either change your DNS to 8.8.8.8 and 1.1.1.1, or add an exception for miniops.me to the router."
        $Failed = $true
    }
    if ($Failed) {
        Write-Host "This machine does not meet the Trustant requirements"
        return
    }
    try {
        # New-Item rejects a drive root (D:\) even with -Force: create only if missing.
        if (-not (Test-Path -PathType Container $Target)) {
            New-Item -ItemType Directory -Force -Path $Target -ErrorAction Stop | Out-Null
        }
        Set-Location $Target -ErrorAction Stop
    } catch {
        Write-Host "cannot use $Target - $_"
        return
    }

    if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
        if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
            Write-Host "git is required: install it from https://git-scm.com and retry"
            return
        }
        Write-Host "Installing git with winget"
        winget install --id Git.Git -e --source winget --accept-package-agreements --accept-source-agreements
        # winget updates the registry PATH, not this session's: reload it.
        $env:Path = [Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' +
                    [Environment]::GetEnvironmentVariable('Path', 'User')
        if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
            Write-Host "git installed but not found - open a new PowerShell and retry"
            return
        }
    }

    if (Test-Path $Dest) {
        Write-Host "$Dest already exists - remove it, or cd there and run .\start.ps1"
        return
    }

    Write-Host "Cloning Trustant into $Dest"
    $Branch = if ($env:TRUSTANT_REF) { @('--branch', $env:TRUSTANT_REF) } else { @() }
    git clone --recurse-submodules @Branch $Url $Dest
    if ($LASTEXITCODE -ne 0) {
        Write-Host "git clone failed"
        Remove-Item -Recurse -Force $Dest -ErrorAction SilentlyContinue
        return
    }
    # A dist\ next to the checkout (the .deb and ollama downloads, preloaded) is
    # copied into trustant\dist, start.sh's cache, so nothing is downloaded again.
    $Src = Join-Path $Target 'dist'
    if (Test-Path -PathType Container $Src) {
        Write-Host "Copying $Src into $Dest\dist"
        try {
            New-Item -ItemType Directory -Force -Path (Join-Path $Dest 'dist') -ErrorAction Stop | Out-Null
            Copy-Item -Recurse -Force -ErrorAction Stop (Join-Path $Src '*') (Join-Path $Dest 'dist')
        } catch {
            Write-Host "copying $Src failed - start.sh will download what is missing"
        }
    }

    Set-Location $Dest
    # .env is read inside WSL: use the /mnt/<drive> form of this folder, LF endings, no BOM.
    $Wsl = '/mnt/' + $Dest.Substring(0, 1).ToLower() + ($Dest.Substring(2) -replace '\\', '/')
    $EnvText = @(
        "WORKSPACE_DIR=$Wsl/workspace"
        "WORKBENCH_DIR=$Wsl/workbench"
        'OLLAMA_ENDPOINT=http://localhost:11434'
        'AIP_REGISTER_URL=https://api.nuvolaris.io/_register'
        'AIP_BASE_URL=https://api.nuvolaris.io/api/v2/'
        'GIT_USER=TrustantUser'
        'GIT_EMAIL=noreply@example.com'
    ) -join "`n"
    [System.IO.File]::WriteAllText((Join-Path $Dest '.env'), "$EnvText`n")
    New-Item -ItemType Directory -Force -Path (Join-Path $Dest 'workspace'), (Join-Path $Dest 'workbench') | Out-Null
    # A child process with Bypass: the default policy may refuse a local .ps1.
    $Shell = (Get-Process -Id $PID).Path
    & $Shell -NoProfile -ExecutionPolicy Bypass -File .\start.ps1
}
return

# Powershell End -----------------------------------------------------------
# ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
out-null
#---------------------------------------------------------------------------
