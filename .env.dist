# Server configuration. Copy to .env, which is mandatory at startup.
# Not to be confused with the optional .env.default in the same directory:
# that one is not server configuration, it only pre-fills the predefined
# environment variables palette on the Configure page (spec/2a-config.md).
WORKSPACE_DIR=/tmp/workspace
WORKBENCH_DIR=/tmp/workbench
OLLAMA_ENDPOINT=http://localhost:11434
AIP_REGISTER_URL=https://api.nuvolaris.io/_register
AIP_BASE_URL=https://api.nuvolaris.io/api/v2/
GIT_USER=TrustableUser
GIT_EMAIL=noreply@example.com
